# ===============================
# APP CONFIG
# ===============================
PORT=3000
NODE_ENV=development

# ===============================
# DATABASE (PostgreSQL)
# ===============================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres        
DB_PASSWORD=123456
DB_NAME=his_db

# Optional (nếu dùng connection string)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/his_db
# ===============================
# JWT AUTH
# ===============================
JWT_SECRET=your_super_secret_key
JWT_EXPIRES_IN=1d

# ===============================
# REDIS (nếu có dùng queue/cache)
# ===============================
REDIS_HOST=localhost
REDIS_PORT=6379

# ===============================
# CLOUDINARY (upload file)
# ===============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===============================
# EMAIL (optional)
# ===============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# ===============================
# FRONTEND URL (CORS)
# ===============================
CLIENT_URL=http://localhost:3001